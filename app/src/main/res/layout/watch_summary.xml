<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="16dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp">
           
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/watchSummaryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/watch_summary"
                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="5dp"/>
            
                <TextView
                    android:id="@+id/totalTrackedItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="10dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Chart: Category Distribution -->
        <TextView
            android:id="@+id/categoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/categories"
            android:layout_below="@id/summaryCard"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="10dp"/>

        <info.appdev.charting.charts.BarChart
            android:id="@+id/categoryChart"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_below="@id/categoryTitle"
            android:layout_marginBottom="10dp" />
            
        <LinearLayout
            android:id="@+id/categoryLegendContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/categoryChart"
            android:layout_marginBottom="20dp" />

        <!-- Secondary Chart: Top Genres -->
        <TextView
            android:id="@+id/genresTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/genres"
            android:layout_below="@id/categoryLegendContainer"
            android:textSize="18sp"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"
            android:textStyle="bold"/>

        <info.appdev.charting.charts.HorizontalBarChart
            android:id="@+id/genreChart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_below="@id/genresTitle"
            android:layout_marginBottom="20dp" />
            
        <!-- Watch Activity Trend -->
        <TextView
            android:id="@+id/activityTrendTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/activity_trend"
            android:layout_below="@id/genreChart"
            android:textSize="18sp"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"
            android:textStyle="bold"/>

        <info.appdev.charting.charts.BarChart
            android:id="@+id/activityTrendChart"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_below="@id/activityTrendTitle"
            android:layout_marginBottom="20dp" />

        <!-- Ratings Insight -->
        <TextView
            android:id="@+id/ratingsInsightTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ratings_insight"
            android:layout_below="@id/activityTrendChart"
            android:textSize="18sp"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="10dp"
            android:textStyle="bold"/>

        <info.appdev.charting.charts.LineChart
            android:id="@+id/ratingsInsightChart"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_below="@id/ratingsInsightTitle"
            android:layout_marginBottom="20dp" />
            
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone"
            app:shimmer_duration="700">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <include layout="@layout/show_skeleton" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>